{
  "name": "pubky-ring-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit": "npm audit --audit-level=moderate",
    "build": "tsc && vite build",
    "check": "tsc",
    "dev": "vite",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/pubky.test.js .test-dist/test/recovery-input.test.js .test-dist/test/profile.test.js test/sdk-compatibility.test.mjs",
    "test:compatibility": "tsc -p tsconfig.test.json && node --test test/sdk-compatibility.test.mjs"
  },
  "dependencies": {
    "@scure/bip39": "2.4.0",
    "@synonymdev/pubky": "^0.17.1",
    "jdenticon": "^3.3.0",
    "pubky-app-specs": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.3"
  }
}
